# ================================================================
# ApniDukaan Frontend Environment Configuration
# ================================================================
#
# VITE_* variables are INLINED INTO THE CLIENT BUNDLE at build time and are
# therefore PUBLIC. Anyone can read them by viewing the page source or the
# JavaScript bundle.
#
# NEVER put an API key, token or secret in this file or in any VITE_ variable.
# Only public URLs belong here.
#
# Local development: leave this unset. Requests go to the relative path /api
# and the Vite dev-server proxy forwards them to http://localhost:5000
# (see vite.config.js). This keeps the browser same-origin in dev, so no CORS
# round trip is involved.
#
# ================================================================

# Base origin of the deployed backend. Must be the bare origin with NO trailing
# slash and NO /api suffix — the client appends /api itself.
# Example: https://dukaanquest-api.vercel.app
# Leave EMPTY for local development.
VITE_API_BASE_URL=