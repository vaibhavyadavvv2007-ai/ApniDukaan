# ================================================================
# DukaanQuest Backend Environment Configuration
# HackSprint 2026 | PS-21: Democratizing Digital Commerce for Bharat
# ================================================================
#
# THIS FILE CONTAINS VARIABLE NAMES AND DEFAULTS ONLY. NEVER put a
# real secret value here. `server/.env` holds the real values locally
# and is git-ignored; on Vercel the same names are set as Project
# Environment Variables, never as a committed file.
#
# Deployed hosts do NOT read this file. They inject variables from the
# environment, so the names here must match those set in Vercel exactly.

# ================================================================
# 0. DEPLOYMENT (required on Vercel)
# ================================================================

# Port is supplied automatically by the platform. Set locally to 5000.
PORT=5000

# Origin of the deployed frontend, comma-separated for multiple.
# Used by the CORS allowlist. Example: https://dukaanquest.vercel.app
# Leave unset locally; the Vite dev origins are allowed automatically.
FRONTEND_URL=

# ----------------------------------------------------------------
# 1. Google Gemini AI Engine
# Get key at: https://aistudio.google.com/
#
# Dual-Model Architecture:
# - GEMINI_TEXT_MODEL: Text extraction, marketplace bullets, compliance
#   Default: gemini-3.1-flash-lite (cost/latency efficient)
# - GEMINI_IMAGE_MODEL: Photo Studio hero image generation & editing
#   Default: gemini-3.1-flash-image (Nano Banana 2, hero quality)
#   Alternative: gemini-3.1-flash-lite-image (Nano Banana 2 Lite, latency optimized)
# ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ----------------------------------------------------------------
# 2. Sarvam AI Indic Regional Language Engine (Hindi, Kannada, Tamil)
# Get subscription key at: https://sarvam.ai/
# Models: Translation (mayura:v1), STT (saaras:v4), TTS (bulbul:v3)
# ----------------------------------------------------------------
SARVAM_API_KEY=

# ----------------------------------------------------------------
# 3. n8n Automation Engine
# Self-hosted (e.g. localhost:5678) or n8n Cloud webhook
# ----------------------------------------------------------------
# DEPLOYMENT REQUIREMENT: a deployed backend CANNOT reach localhost:5678.
# n8n must be reachable from the public internet (n8n Cloud, or self-hosted
# behind ngrok/cloudflared). When VERCEL=1 and this variable is unset, the
# app reports n8n as NOT_CONFIGURED instead of dialling localhost.
# Local development falls back to localhost:5678 automatically.
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/dukaanquest-crm

# Meta WhatsApp Cloud API delivery-status callback.
# Meta POSTs sent/delivered/failed (e.g. 131049) here AFTER the send API returns,
# which is the only trustworthy delivery signal. Register this endpoint on the
# WABA for the `messages` field, exposing it publicly (ngrok/cloudflared) because
# Meta cannot reach localhost.
META_WEBHOOK_VERIFY_TOKEN=apnidukaan_verify_2026

N8N_WEBHOOK_SECRET=

# ----------------------------------------------------------------
# 4. Meta WhatsApp Business Cloud API
# Meta for Developers: https://developers.facebook.com/
# ----------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=

# ----------------------------------------------------------------
# 4b. Active WhatsApp Template
# NORMAL merchant campaigns use the Meta-APPROVED marketing template.
# Verified live against the WABA: APPROVED, category MARKETING,
# locale "en" (NOT "en_US"), POSITIONAL body variables in this exact order:
#   {{1}} customer name   {{2}} collection name
#   {{3}} shop name       {{4}} discount
# The header ("BIG SAVING !!") contains no variables and there are no
# buttons, so no header/button components are sent.
# ----------------------------------------------------------------
# ACTIVE TEMPLATE: hello_world (Meta-APPROVED, category UTILITY, locale 'en_US',
# no body variables).
# OPERATOR DECISION: the MARKETING template dukaanquest_new_arrival is approved and
# correctly formed, but Meta's engagement filter (delivery error 131049) suppresses
# marketing-template sends to recipients with no prior engagement. hello_world is a
# UTILITY template and passes that filter, so it is the only template on this test
# number that is actually delivered. Consequence: campaigns carry NO personalization
# (no customer name, collection, shop name or discount) because hello_world declares
# no approved variables.
# To restore personalized campaigns, submit a UTILITY-category template declaring
# {{1}}customerName {{2}}collectionName {{3}}shopName {{4}}discount and await approval.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
# TECHNICAL TEST ONLY: set WHATSAPP_TEMPLATE_NAME=hello_world to verify
# WhatsApp connectivity. Never used for merchant campaigns.
WHATSAPP_CUSTOM_TEMPLATE_NAME=dukaanquest_new_arrival

# ----------------------------------------------------------------
# 5. Paytm FinTech Staging Credentials & Adapter
# Paytm Developer Portal: https://business.paytm.com/docs/api/create-link-api/
# NOTE: Paytm test-key generation is currently unavailable on dashboard.
# System operates in STAGED/FALLBACK mode with demo data, never LIVE.
# If real staging keys become available later, populate PAYTM_MERCHANT_KEY
# to enable the live staging call without any architectural changes.
# ----------------------------------------------------------------
PAYTM_ENVIRONMENT=STAGED_FALLBACK
PAYTM_MID=PAYTM_MID_984521
PAYTM_KEY=PAYTM_SECRET_KEY_DEMO
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CALLBACK_URL=http://127.0.0.1:5000/api/paytm/callback

# ----------------------------------------------------------------
# 6. Marketplace Partner Credentials (Sandbox / Staged)
# Amazon SP-API: https://developer-docs.amazon.com/sp-api/
# ----------------------------------------------------------------
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=eu-west-1
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_APP_ID=

# Flipkart Seller API: https://seller.flipkart.com/api-docs/
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
FLIPKART_REDIRECT_URI=
